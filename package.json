{
  "name": "phoenix-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal Pi agent. One container, one shareable setup file.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "npm run build && node src/bootstrap.ts",
    "build": "node src/build.ts",
    "test": "npm run build && node --test --test-concurrency=2 tests/*.test.ts",
    "typecheck": "node --max-old-space-size=1024 node_modules/typescript/bin/tsc --noEmit",
    "check": "npm run typecheck && eslint --flag unstable_native_nodejs_ts_config ."
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.0.0",
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@slack/socket-mode": "3.1.0",
    "@slack/web-api": "7.15.0",
    "@types/dom-speech-recognition": "0.0.12",
    "@types/katex": "0.16.8",
    "@types/mailparser": "3.9.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/ws": "8.18.2",
    "discord.js": "14.27.0",
    "dompurify": "3.4.16",
    "imapflow": "2.2.1",
    "katex": "0.19.0",
    "mailparser": "3.9.33",
    "markdown-it": "15.0.2",
    "markdown-it-texmath": "1.0.0",
    "nodemailer": "10.0.13",
    "patchright-core": "1.63.0",
    "pdfjs-dist": "6.4.299",
    "typebox": "1.3.27",
    "typescript": "6.0.2",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "typescript-eslint": "8.71.0"
  }
}

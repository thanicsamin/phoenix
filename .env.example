# Optional: save provider keys in Settings, or use Pi's provider environment variables.
# Choose a provider and matching Pi model ID in agent.json (or per chat in the UI).
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional: omit to generate a strong password on first launch.
PHOENIX_PASSWORD=
# Add credentials only for extensions enabled in agent.json.
TELEGRAM_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_BOT_TOKEN=
DISCORD_BOT_TOKEN=
EMAIL_PASSWORD=
# Optional: or save Plaid credentials in Settings → Finances. Sandbox by default.
PLAID_CLIENT_ID=
PLAID_SECRET=
CLOUDFLARE_TUNNEL_TOKEN=

# Optional: timezone for the agent and its daily notes.
TZ=UTC

# Hard cap for the full container, including all browser processes.
PHOENIX_MEMORY_LIMIT=2g
PHOENIX_CPU_LIMIT=1
# VPS HTTPS: Oracle detects the public IPv4 automatically; override if needed.
# PHOENIX_PUBLIC_IP=203.0.113.10
# PHOENIX_HTTPS_PORT=24843
# Other VPS hosts: enable the public proxy profile.
# COMPOSE_PROFILES=public
# Structured logs: debug, info, warn, error, fatal, silent.
PHOENIX_LOG_LEVEL=info
